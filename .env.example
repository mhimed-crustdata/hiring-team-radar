# Required: your Crustdata API key (https://docs.crustdata.com)
CRUSTDATA_API_KEY=

# Target companies (domains, comma list) and how far back to look
COMPANIES=datadog.com,cloudflare.com,snowflake.com
SINCE_DAYS=7

# Optional: Slack incoming webhook (leave empty to skip)
SLACK_WEBHOOK_URL=

# Optional: Claude step (pip install -r requirements-optional.txt)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
